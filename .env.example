# PostgreSQL（docker-compose で使用）
POSTGRES_USER=cashpilot
POSTGRES_PASSWORD=cashpilot
POSTGRES_DB=cashpilot

# マイグレーション・バックエンド用（ローカル実行時）
# DATABASE_URL=postgres://cashpilot:cashpilot@localhost:5432/cashpilot?sslmode=disable

# CORS（フロントのオリジン。省略時は http://localhost:3010）
# CORS_ALLOW_ORIGIN=http://localhost:3010

# JWT 署名用（32文字以上推奨）。未設定時は signup/login が動作しない
JWT_SECRET=cashpilot-local-dev-secret-key-at-least-32-chars
