# Local development environment variables for CashPilot.
# Do not commit real secrets in this file.

# PostgreSQL (used by docker-compose)
POSTGRES_USER=cashpilot
POSTGRES_PASSWORD=cashpilot
POSTGRES_DB=cashpilot

# Migration / backend local execution
DATABASE_URL=postgres://cashpilot:cashpilot@localhost:5432/cashpilot?sslmode=disable

# CORS (frontend origin). Defaults to http://localhost:3010 when omitted.
CORS_ALLOW_ORIGIN=http://localhost:3010

# JWT signing secret (MUST be replaced with a random 32+ char string).
# Example only: use your own strong random value before login/signup testing.
JWT_SECRET=replace-with-a-random-32-plus-character-secret
